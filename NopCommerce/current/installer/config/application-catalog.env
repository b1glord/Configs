# 📄 Dosya Yolu: /NopCommerce/current/installer/config/application-catalog.env
# 📌 Amac: nopCommerce uygulama deployment modlarini ve surume gore Docker runtime profilini tanimlamak
# 📌 Modul - Env
# Version: 1.0.0
# Aciklama: Native/Docker uygulama modu, resmi nopCommerce Dockerfile runtime tabanlari ve paket profilleri
# Bagimli Oldugu Katman: Repo | Service | Tool

NOP_APP_MODES="native:docker"

NOP_DOCKER_APP_RUNTIME_IMAGES="4.30=mcr.microsoft.com/dotnet/core/aspnet:3.1-alpine;4.40=mcr.microsoft.com/dotnet/aspnet:5.0-alpine;4.50=mcr.microsoft.com/dotnet/aspnet:6.0-alpine;4.60=mcr.microsoft.com/dotnet/aspnet:7.0-alpine;4.70=mcr.microsoft.com/dotnet/aspnet:8.0-alpine;4.80=mcr.microsoft.com/dotnet/aspnet:9.0-alpine;4.90=mcr.microsoft.com/dotnet/aspnet:9.0-alpine;5.00=mcr.microsoft.com/dotnet/aspnet:10.0-alpine"

NOP_DOCKER_APP_RUNTIME_PROFILES="4.30=legacy31;4.40=legacy50;4.50=runtime60;4.60=runtime70;4.70=runtime80;4.80=runtime90;4.90=runtime90gcompat;5.00=runtime100"
