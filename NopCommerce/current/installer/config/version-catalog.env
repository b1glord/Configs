# 📄 Dosya Yolu: /NopCommerce/current/installer/config/version-catalog.env
# 📌 Amac: Desteklenen nopCommerce surum ailelerini, alias degerlerini ve .NET runtime kanallarini tanimlamak
# 📌 Modul - Env
# Version: 1.0.1
# Aciklama: Eski ve yeni nopCommerce surumleri icin merkezi surum katalogu
# Bagimli Oldugu Katman: Repo | Service

NOP_SUPPORTED_VERSION_FAMILIES="4.30:4.40:4.50:4.60:4.70:4.80:4.90"
NOP_VERSION_PATTERN='^4\.[0-9]{2}(\.[0-9]+)?$'

NOP_VERSION_ALIASES="latest=4.90.8;4.50=4.50.0;4.60=4.60.0;4.70=4.70.0;4.80=4.80.0;4.90=4.90.0;latest-4.30=4.30;latest-4.40=4.40.4;latest-4.50=4.50.4;latest-4.60=4.60.6;latest-4.70=4.70.5;latest-4.80=4.80.9;latest-4.90=4.90.8"

NOP_RUNTIME_CHANNELS="4.30=3.1;4.40=5.0;4.50=6.0;4.60=7.0;4.70=8.0;4.80=9.0;4.90=9.0"

NOP_LEGACY_VERSION_FAMILIES="4.30:4.40:4.50:4.60"
