# 📄 Dosya Yolu: /NopCommerce/current/installer/config/database-catalog.env
# 📌 Amac: nopCommerce surum ailelerine gore desteklenen veritabani provider ve deployment modlarini tanimlamak
# 📌 Modul - Env
# Version: 1.1.0
# Aciklama: Provider alias, surum uyumlulugu ve Docker provisioning destegi katalogu
# Bagimli Oldugu Katman: Repo | Service | Tool

NOP_DB_PROVIDER_ALIASES="web=Web;sqlserver=SqlServer;mssql=SqlServer;mysql=MySql;postgresql=PostgreSQL;postgres=PostgreSQL"

NOP_DB_PROVIDER_SUPPORT="4.30=SqlServer,MySql;4.40=SqlServer,MySql,PostgreSQL;4.50=SqlServer,MySql,PostgreSQL;4.60=SqlServer,MySql,PostgreSQL;4.70=SqlServer,MySql,PostgreSQL;4.80=SqlServer,MySql,PostgreSQL;4.90=SqlServer,MySql,PostgreSQL;5.00=SqlServer,MySql,PostgreSQL"

NOP_DB_MODES="external:docker"
NOP_DB_DOCKER_PROVIDERS="MySql:PostgreSQL"
