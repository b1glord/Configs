# 📄 Dosya Yolu: /OFBİZ/.env.example
# 📌 Amac: OFBiz Docker calisma degiskenleri icin ornek ortam dosyasi
# 📌 Config - ENV
# Version: 1.0.0
# Aciklama: Docker image, container ve port ayarlarini merkezi olarak tanimlar
#
# Bagimli Oldugu Katman: Config

OFBIZ_VERSION=24.09.07
OFBIZ_IMAGE=local/ofbiz:24.09.07
OFBIZ_CONTAINER_NAME=ofbiz
OFBIZ_HTTPS_PORT=8443
OFBIZ_AJP_PORT=8009
OFBIZ_DEBUG_PORT=5005
